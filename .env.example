# GEO I — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase (GEO I's own account, NOT KOS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Profound — real-user prompt data
PROFOUND_API_KEY=

# Gemini — answer generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional, later vendors
AHREFS_API_KEY=
BING_WMT_API_KEY=

# Backend read API (shared secret — leave empty for local dev only)
GEOI_API_KEY=
