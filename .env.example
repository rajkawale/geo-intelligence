# GEO I — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase (GEO I's own account, NOT KOS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Profound — real-user prompt data
PROFOUND_API_KEY=
# Find via POST /v1/org/categories (X-API-Key header) — category names are
# frequently duplicated/unlabeled, confirm the exact one before setting this.
PROFOUND_CATEGORY_ID=

# Gemini — answer generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pilot brand — used by run-gemini.js. Blank falls back to a placeholder.
GEOI_BRAND=
GEOI_COMPETITORS=

# fetch-profound.js — resumable, checkpointed in geoi.profound_fetch_state.
# 200 rows/page (Profound's own max). Each run does up to
# PROFOUND_MAX_PAGES_PER_RUN pages per brand, saves its cursor, and picks up
# from there next run — run it again (or on a schedule) to keep backfilling.
PROFOUND_FETCH_WINDOW_DAYS=7
PROFOUND_MAX_PAGES_PER_RUN=20

# Optional, later vendors
AHREFS_API_KEY=
BING_WMT_API_KEY=

# Backend read API (shared secret — leave empty for local dev only)
GEOI_API_KEY=
